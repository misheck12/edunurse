# Public app
APP_PORT=80
VITE_API_BASE_URL=/api/v1
FRONTEND_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# Database
POSTGRES_DB=edunurse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Auth / admin bootstrapping
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=86400
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-now

# Logging / worker
LOG_LEVEL=info
EXPORT_WORKER_POLL_MS=2000
WORKER_STALE_LOCK_MINUTES=20

# LLM provider priority
LLM_PROVIDER_PRIORITY=azure,gemini,deepseek

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# DeepSeek (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Embeddings
INGESTION_EMBEDDINGS_ENABLED=true
EMBEDDING_PROVIDER_PRIORITY=azure,gemini,local
EMBEDDING_VECTOR_DIM=1536

# Google OAuth (for Drive connector)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI used by frontend OAuth code flow.
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com

# Payments (optional)
LENCO_API_KEY=
LENCO_API_BASE_URL=https://api.lenco.co/access/v2

# Email (optional)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@example.com
SUPPORT_EMAIL=support@example.com
WHATSAPP_GROUP_LINK=

# AI images for PPT (optional)
PRESENTATION_ENABLE_AI_IMAGES=false
PRESENTATION_AI_IMAGE_PROVIDER=openai
OPENAI_IMAGES_API_KEY=
OPENAI_IMAGES_MODEL=gpt-image-1
AZURE_DALLE_ENDPOINT=
AZURE_DALLE_API_KEY=
AZURE_DALLE_MODEL=dall-e-3
AZURE_DALLE_STYLE=vivid
AZURE_DALLE_QUALITY=standard
