# ─── API ───────────────────────────────────────────────────────
# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ─── Google OAuth (optional) ──────────────────────────────────
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=

# ─── Development ──────────────────────────────────────────────
# Set to "true" to enable the X-Dev-User-Id auth bypass (dev only!)
VITE_ENABLE_DEV_AUTH_BYPASS=false
# Override the default dev user UUID
# VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000001
