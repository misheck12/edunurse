NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# For multiple origins, separate with comma:
# CORS_ORIGIN=https://app.example.com,https://ops.example.com
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edunurse?schema=public
EXPORT_STORAGE_DIR=./storage/exports
EXPORT_WORKER_POLL_MS=2000
PRESENTATION_IMAGES_MAX=3
PRESENTATION_IMAGE_FETCH_TIMEOUT_MS=12000
PRESENTATION_ENABLE_AI_NOTES=true
PRESENTATION_AI_NOTES_MAX_OBJECTIVES=4
PRESENTATION_ENABLE_AI_IMAGES=false
PRESENTATION_AI_IMAGE_PROVIDER=openai
OPENAI_IMAGES_API_KEY=
OPENAI_IMAGES_MODEL=gpt-image-1
OPENAI_IMAGES_TIMEOUT_MS=45000
AZURE_DALLE_ENDPOINT=
AZURE_DALLE_API_KEY=
AZURE_DALLE_MODEL=dall-e-3
AZURE_DALLE_STYLE=vivid
AZURE_DALLE_QUALITY=standard
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=180
CONNECTOR_HTTP_TIMEOUT_MS=20000
OCR_FALLBACK_ENABLED=false
OCR_LANGUAGE=eng
OCR_MIN_TEXT_LENGTH=100
OCR_PDF_MAX_PAGES=5
OCR_DOCX_MAX_IMAGES=8
OCR_PDF_RENDER_SCALE=1.75
GENERATION_TIMEOUT_MS=45000
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=180
RETRIEVAL_MIN_COVERAGE=3
RETRIEVAL_VECTOR_WEIGHT=40
RETRIEVAL_FTS_WEIGHT=18
INGESTION_EMBEDDINGS_ENABLED=true
EMBEDDING_PROVIDER_PRIORITY=azure,gemini,local
EMBEDDING_VECTOR_DIM=1536
EMBEDDING_TIMEOUT_MS=30000
AUTH_TOKEN_SECRET=replace_this_with_a_long_random_secret
AUTH_TOKEN_TTL_SECONDS=86400
SUPERADMIN_EMAIL=superadmin@edunurse.local
SUPERADMIN_PASSWORD=ChangeMe123!
LLM_PROVIDER_PRIORITY=azure,gemini,deepseek

# Azure OpenAI
# You can use either:
# - resource endpoint: https://<resource>.services.ai.azure.com
# - project endpoint:  https://<resource>.services.ai.azure.com/api/projects/<project>
# The backend normalizes project endpoint to resource endpoint automatically.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Google OAuth (for server-managed Drive connector auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match frontend redirect URI (same origin recommended for popup flow).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000

# Lenco Payment API
LENCO_API_KEY=
LENCO_API_BASE_URL=https://api.lenco.co/access/v2

# Email Configuration
EMAIL_ENABLED=true
EMAIL_FROM=noreply@edunurse.com
SUPPORT_EMAIL=support@edunurse.com
FRONTEND_URL=http://localhost:3000

# WhatsApp Support Group
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/C8C0MfZIUKl5Mka271hCWv
